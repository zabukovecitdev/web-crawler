# Copy this file to .env. Docker Compose and Rider read .env next to compose.yaml.
# Required. Generate with: openssl rand -hex 32
DASHBOARD_API_KEY=

# Development credentials of the backing services. The defaults are fine on a laptop (every port binds to
# 127.0.0.1); change them for anything else. Avoid ; = and spaces in the database password.
POSTGRES_PASSWORD=samobot
# S3 storage (RustFS)
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
# Meilisearch master key
MEILI_MASTER_KEY=masterKey

# Google sign-in for the dashboard (Web application OAuth client; the dashboard origin must be an authorised JavaScript origin).
GOOGLE_CLIENT_ID=
# Who may sign in, comma-separated. Both empty = nobody can sign in with Google (the API key still works).
# Changing these needs a container restart (environment variables are read once).
AUTH_ALLOWED_EMAILS=
AUTH_ALLOWED_DOMAINS=
# Origin of the dashboard SPA, for CORS with credentials.
CORS_ORIGIN=http://localhost:5173
# Compose serves plain http on localhost, so the session cookie may be sent without Secure.
# Set to false behind HTTPS.
AUTH_ALLOW_INSECURE_COOKIE=true

# JavaScript rendering (needs the compose profile js, see the README).
CHROME_RENDERING_ENABLED=false
