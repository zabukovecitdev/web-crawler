# Copy this file to .env. Docker Compose and Rider read .env next to compose.yaml.
DASHBOARD_API_KEY=change-me

# Google sign-in for the dashboard (Web application OAuth client; the dashboard origin must be an authorised JavaScript origin).
GOOGLE_CLIENT_ID=
# Who may sign in, comma-separated. Both empty = nobody can sign in with Google (the API key still works).
AUTH_ALLOWED_EMAILS=
AUTH_ALLOWED_DOMAINS=
# Origin of the dashboard SPA, for CORS with credentials.
CORS_ORIGIN=http://localhost:5173
