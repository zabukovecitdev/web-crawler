# Base URL of SamoBot.Api. Requests are sent with credentials: 'include' (cookie session).
VITE_API_BASE=http://localhost:5288
# Google OAuth web client id (the same one as Google:ClientId in the API).
VITE_GOOGLE_CLIENT_ID=
# Serve every endpoint from MSW fixtures, no server needed.
VITE_USE_MOCKS=false
