# Base URL of SamoBot.Api. Requests are sent with credentials: 'include' (cookie session).
# The API listens on http://localhost:5080 with both dotnet run (Rider) and docker compose.
VITE_API_BASE=http://localhost:5080
# Google OAuth web client id (the same one as Google:ClientId in the API).
VITE_GOOGLE_CLIENT_ID=
# Serve every endpoint from MSW fixtures, no server needed.
VITE_USE_MOCKS=false

# Local development without Google sign-in (npm run dev only). Set VITE_API_BASE to an empty value above, so
# the app calls the dev server, which forwards /api and /hubs to DEV_API_TARGET with the X-Api-Key header.
# DEV_API_KEY is the API's DASHBOARD_API_KEY. It has no VITE_ prefix, so it never reaches the browser.
DEV_API_TARGET=http://localhost:5080
DEV_API_KEY=
