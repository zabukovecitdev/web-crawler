{
  "stryker-config": {
    "project": "SamoBot.Core.csproj",
    "test-projects": ["SamoBot.Tests.csproj"],
    "test-case-filter": "Category!=Integration",
    "coverage-analysis": "perTest",
    "mutation-level": "Standard",
    "reporters": ["html", "json", "progress", "cleartext"],
    "thresholds": { "high": 80, "low": 60, "break": 75 },
    "ignore-methods": ["*Log*", "ToString"],
    "mutate": ["!**/*ServiceCollectionExtensions.cs"]
  }
}
