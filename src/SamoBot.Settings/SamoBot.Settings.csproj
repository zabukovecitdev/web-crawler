<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <AnalysisMode>None</AnalysisMode>
    <RunAnalyzers>false</RunAnalyzers>
    <NoWarn>$(NoWarn);RMG012;RMG020;RMG066;CS8981;nullable</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>appsettings.json</TargetPath>
    </Content>
  </ItemGroup>

  <!-- Target to copy appsettings.json to referencing projects -->
  <Target Name="CopyAppSettingsToReferencingProjects" AfterTargets="Build">
    <ItemGroup>
      <AppSettingsFile Include="$(MSBuildThisFileDirectory)appsettings.json" />
    </ItemGroup>
    <Copy SourceFiles="@(AppSettingsFile)" 
          DestinationFolder="$(OutputPath)" 
          SkipUnchangedFiles="true" 
          Condition="'$(OutputPath)' != ''" />
  </Target>

</Project>
