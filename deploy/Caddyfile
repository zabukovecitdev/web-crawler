# TLS edge for compose.prod.yaml. Caddy gets and renews a Let's Encrypt certificate for $DOMAIN by itself
# (ports 80 and 443 must reach this host, and the DNS name must point at it).
# Caddy sets X-Forwarded-For and X-Forwarded-Proto for the dashboard container, where nginx reads the real
# client address and rate-limits on it; it replaces any such header a client sends itself.
{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# The dashboard container serves the SPA and forwards /api and /hubs (WebSockets included).
	reverse_proxy frontend:8080
}
